  "files_upload": {
    "url": "https://developers.mybox.naver.com/docs/files_upload",
    "method": "GET",
    "endpoint": "",
    "parameters": [
      {
        "field": "fileName",
        "type": "string",
        "mandatory": "필수",
        "description": "업로드 할 파일 이름. 확장자를 유지하고 싶은 경우, 반드시 확장자까지 포함하여 입력하세요."
      },
      {
        "field": "fileSize",
        "type": "integer",
        "mandatory": "필수",
        "description": "업로드할 파일 크기(byte)로, 0 이상으로 입력하세요. 크기 미입력 시 오류가 발생될 수 있습니다. 최소 0"
      },
      {
        "field": "isOverwrite",
        "type": "boolean",
        "mandatory": "선택",
        "description": "동일 이름 존재 시 덮어쓰기 여부"
      },
      {
        "field": "modifiedTime",
        "type": "string",
        "mandatory": "선택",
        "description": "파일 수정일시로, 이어올리기 여부(resume)와 함께 입력하세요."
      },
      {
        "field": "parentId",
        "type": "string",
        "mandatory": "선택",
        "description": "파일을 업로드할 폴더 ID(생략 시, 루트에 업로드)"
      },
      {
        "field": "resume",
        "type": "boolean",
        "mandatory": "선택",
        "description": "이어올리기 여부. 업로드가 중단된 경우 중단 지점부터 다시 올리려면 true로 입력하고, modifiedTime과 함께 전송하세요."
      },
      {
        "field": "offset",
        "type": "integer",
        "mandatory": "선택",
        "description": "업로드가 중단된 경우, 이어올리기 시작점.(이어올리기가 아닌 경우, 0)"
      },
      {
        "field": "uploadUrl",
        "type": "string",
        "mandatory": "필수",
        "description": "파일 업로드용 URL로, 48시간 동안 유효하고 업로드 후 재사용 불가합니다. multipart/form-data의 Filedata 항목으로 POST 하세요."
      },
      {
        "field": "400",
        "type": "PLAT-400",
        "description": "BAD_REQUEST"
      },
      {
        "field": "401",
        "type": "PLAT-401",
        "description": "UNAUTHORIZED"
      },
      {
        "field": "403",
        "type": "PLAT-403",
        "description": "FORBIDDEN"
      },
      {
        "field": "404",
        "type": "PLAT-404",
        "description": "NOT_FOUND"
      },
      {
        "field": "409",
        "type": "PLAT-409",
        "description": "CONFLICT"
      },
      {
        "field": "422",
        "type": "PLAT-422",
        "description": "UNPROCESSABLE_ENTITY"
      },
      {
        "field": "423",
        "type": "PLAT-423",
        "description": "LOCKED"
      },
      {
        "field": "429",
        "type": "PLAT-429",
        "description": "TOO_MANY_REQUESTS"
      },
      {
        "field": "500",
        "type": "PLAT-500",
        "description": "INTERNAL_SERVER_ERROR"
      },
      {
        "field": "502",
        "type": "PLAT-502",
        "description": "BAD_GATEWAY"
      },
      {
        "field": "503",
        "type": "PLAT-503",
        "description": "SERVICE_UNAVAILABLE"
      },
      {
        "field": "507",
        "type": "PLAT-507",
        "description": "INSUFFICIENT_STORAGE"
      }
    ]
  },
